}

# ---------------------------------------------------------------------------------
main() {
  local args=() a
  for a in "$@"; do
    case "$a" in
      -y|--yes) SS_ASSUME_YES=1 ;;
      -n|--dry-run) SS_DRY_RUN=1 ;;
      --force) SS_FORCE=1 ;;
      --allow-root) SS_ALLOW_ROOT=1 ;;
      --purge-packages) SS_PURGE_PACKAGES=1 ;;
      --purge) SS_PURGE=1 ;;
      --custom) SS_PROMPT_CHOICE=on ;;
      --default) SS_PROMPT_CHOICE=off ;;
      --font=*) SS_FONT_CHOICE="${a#--font=}" ;;
      -h|--help) args+=(help) ;;
      -V|--version) args+=(version) ;;
      *) args+=("$a") ;;
    esac
  done
  set -- "${args[@]+"${args[@]}"}"
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    list|ls) cmd_list ;;
    install) cmd_install "$@" ;;
    update|upgrade) cmd_update ;;
    remove|rm) cmd_remove "$@" ;;
    uninstall) cmd_uninstall ;;
    doctor|check) cmd_doctor ;;
    bench) cmd_bench "$@" ;;
    mode) cmd_mode "$@" ;;
    devops) cmd_devops "$@" ;;
    icons) cmd_icons "$@" ;;
    prompt) cmd_prompt "$@" ;;
    font) cmd_font "$@" ;;
    config) cmd_config "$@" ;;
    restore) cmd_restore "$@" ;;
    repair) cmd_repair ;;
    keys|shortcuts) cmd_keys ;;
    version) echo "supershell $SS_VERSION" ;;
    help) usage ;;
    *) err "Unknown command '$cmd'"; usage >&2; exit 2 ;;
  esac
}

main "$@"
